SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

DB_NAME=greenish_db
DB_USER=greenish_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Development e email console e print hoy. Production e SMTP dite hobe.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Greenish Trade <no-reply@greenish.com>

# SMS: "console" mane terminal e print hobe. Real SMS gateway lagle utils.py te send_sms edit korun.
SMS_BACKEND=console

OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
